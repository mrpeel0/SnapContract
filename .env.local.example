# Use OpenAI (preferred when set; OPENAI_MODEL defaults to gpt-5.5):
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# Or Claude:
ANTHROPIC_API_KEY=
# Or a local Ollama model (used only when no Anthropic key is set):
# LOCAL_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# ---- Messaging apps (any combination; each side links by scanning a QR on the project page) ----
# Telegram bot from @BotFather.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup).
# Webhook URL: https://<public tunnel>/api/whatsapp, subscribe to "messages".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: verifies webhook signatures (App settings → Basic → App secret)
# WHATSAPP_APP_SECRET=
# Optional: skip the Graph lookup of the number shown in wa.me links
# WHATSAPP_DISPLAY_NUMBER=+1 555 010 0199

# iMessage through this Mac's Messages app (macOS only; terminal needs Full Disk Access).
# IMESSAGE_HANDLE is the phone/email people text, i.e. the Apple ID signed into Messages.
# IMESSAGE_ENABLED=1
# IMESSAGE_HANDLE=you@icloud.com

# Ramp Developer API (Sandbox: demo-api.ramp.com). Leave blank to issue demo cards.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Optional. Defaults to the first user on the Ramp account.
RAMP_USER_ID=
# sandbox (default) or production
RAMP_ENV=sandbox
