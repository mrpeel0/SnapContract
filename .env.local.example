# Use Claude (preferred):
ANTHROPIC_API_KEY=
# Or a local Ollama model (used only when no Anthropic key is set):
# LOCAL_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434

# Telegram bot from @BotFather. The project conversation runs in this bot.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API. Leave blank to use the in-app WhatsApp demo stage.
# Webhook: https://YOUR_HOST/api/whatsapp  (subscribe to messages)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional. When set, webhook posts must be signed with this app secret.
# WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v21.0

# iMessage has no Apple API. Live send uses a LoopMessage-compatible endpoint.
# Inbound webhook: https://YOUR_HOST/api/imessage
IMESSAGE_API_KEY=
# IMESSAGE_SENDER=
# IMESSAGE_API_URL=https://server.loopmessage.com/api/v1/message/send
# IMESSAGE_WEBHOOK_SECRET=

# Ramp Developer API (Sandbox: demo-api.ramp.com). Leave blank to issue demo cards.
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Optional. Defaults to the first user on the Ramp account.
RAMP_USER_ID=
# sandbox (default) or production
RAMP_ENV=sandbox
